# Copy this file to .env and fill in your values.

# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: a server ID to sync slash commands to instantly while testing.
# Leave empty to register commands globally.
DEV_GUILD_ID=

# Where the shared SQLite database lives.
DATABASE_PATH=data/robloxchecker.db

# How often (in minutes) tracked players are rescanned.
TRACK_INTERVAL_MINUTES=360

# Max badges fetched per player per scan (100 per request).
MAX_BADGES=500

LOG_LEVEL=INFO
